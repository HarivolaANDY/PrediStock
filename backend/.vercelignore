# ─── Local Development ──────────────────────────────────────
db.sqlite3
*.sqlite3*

# ─── Media & Uploads (won't persist on Vercel) ─────────────
media/
pdf_uploads/
temp_pdf/
rapports/

# ─── Static Files (collected during build) ──────────────────
staticfiles/
static/

# ─── Python Bytecode Cache ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ─── Virtual Environment ───────────────────────────────────
.venv*/
venv*/
env*/

# ─── Logs & Debug ──────────────────────────────────────────
*.log
failed_queries.jsonl

# ─── Secrets & Environment ─────────────────────────────────
.env*
*.key
*.pem

# ─── Training Artifacts (not needed at runtime) ────────────
apps/forecasting/training/
apps/forecasting/sql_model_weights/

# ─── OS Files ──────────────────────────────────────────────
.DS_Store
Thumbs.db
