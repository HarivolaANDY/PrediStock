# ─── PrediStock Backend — Environment Variables ────────────
# Copy this file to .env for local development.
# For Vercel deployment, set these in the Vercel Project Dashboard.
#
# Settings → Environment Variables → Add each variable.


# ─── Django Core ──────────────────────────────────────────

# SECRET KEY — Generate a strong, unique key for production.
#   Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY="django-insecure-your-production-secret-key-here"

# DEBUG — Must be False in production.
DJANGO_DEBUG="False"

# ALLOWED_HOSTS — Comma-separated list of allowed hosts.
#   Include your Vercel backend domain, e.g.: .vercel.app,localhost
ALLOWED_HOSTS=".vercel.app,localhost"

# CORS_ALLOWED_ORIGINS — Comma-separated list of frontend origins.
#   Include your Vercel frontend domain, e.g.: https://your-frontend.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS="http://localhost:5173"


# ─── Database (PostgreSQL) ─────────────────────────────────

# DATABASE_URL — Connection string for PostgreSQL.
#   Format: postgresql://user:password@host:port/dbname
#   Use a managed provider like Neon, Supabase, or Render Postgres.
DATABASE_URL="postgresql://user:password@host:5432/predistock"


# ─── Security (Production) ────────────────────────────────

# Set both to True for HTTPS-only production environments.
SESSION_COOKIE_SECURE="True"
CSRF_COOKIE_SECURE="True"


# ─── AI / Integrations ─────────────────────────────────────

# GOOGLE_API_KEY — Required for Gemini AI features (chatbot).
GOOGLE_API_KEY="your-google-api-key"

# NEXUM_API_KEY — Alternative AI provider (optional).
NEXUM_API_KEY=""
NEXUM_BASE_URL=""
