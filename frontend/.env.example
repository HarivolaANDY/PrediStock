# ─── PrediStock Frontend — Environment Variables ───────────
# Copy this file to .env for local development.
# For Vercel deployment, set these in the Vercel Project Dashboard.
#
# Settings → Environment Variables → Add each variable.
# ⚠️ Vite requires the VITE_ prefix for build-time variables.


# ─── API Configuration ─────────────────────────────────────

# VITE_API_URL — Base URL of the backend API (without /api suffix).
#   Local dev:    http://localhost:8000
#   Vercel prod:  https://your-backend.vercel.app
#   Vercel prev:  https://your-backend-git-branch.vercel.app
#
# The frontend appends /api to this value automatically.
VITE_API_URL="http://localhost:8000"


# ─── Development Only ──────────────────────────────────────

# VITE_DEFAULT_AUTH_TOKEN — Optional default auth token for development.
#   Useful to avoid re-logging in during local development.
#   Do NOT set this in production Vercel environments.
VITE_DEFAULT_AUTH_TOKEN=""
